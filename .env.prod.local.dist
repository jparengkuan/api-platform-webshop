# Template for .env.prod.local, used by: docker compose -f compose.prod.yaml --env-file .env.prod.local
# Copy it, fill in real values and keep the copy out of git (.env.*.local is git-ignored).
# Generate secrets with: openssl rand -hex 32
#
# The stack serves plain HTTP through Varnish; put it behind a TLS-terminating reverse proxy
# (e.g. Coolify) that forwards your domain to the "varnish" service on port 80.

# Images built by the CI: develop (staging, with the demo-data tooling) or master (production).
IMAGE_TAG=master

APP_SECRET=

# OAuth2: encrypts the token signing key and the authorization codes. Never change them later:
# a new passphrase can't open the existing key, a new encryption key invalidates pending codes.
OAUTH_PASSPHRASE=
OAUTH_ENCRYPTION_KEY=

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# RabbitMQ, which receives the integration events (OrderPlaced). Only reachable inside the stack.
RABBITMQ_USER=app
RABBITMQ_PASSWORD=

# Sends the invoice emails to customers, e.g. smtp://user:password@smtp.example.com:587.
# null://null sends nothing. Staging: use a sandbox (e.g. Mailtrap) rather than real delivery.
MAILER_DSN=null://null
MAILER_FROM=webshop@example.com

# Stripe: use the test-mode keys (sk_test_…) on staging, the live keys only in production.
# STRIPE_WEBHOOK_SECRET is the signing secret of the endpoint https://<api domain>/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The frontend Stripe sends the customer back to after paying.
FRONTEND_URL=https://www.example.com

# Regex of browser origins allowed to call the API (your frontend).
CORS_ALLOW_ORIGIN='^https://(www\.)?example\.com$'

# Memory for Varnish's cache.
VARNISH_SIZE=256M

# Local-only port for testing on the server itself: curl http://127.0.0.1:8080/api/products
HTTP_PORT=8080
