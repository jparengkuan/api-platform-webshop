# Template for .env.prod.local, used by: docker compose -f compose.prod.yaml --env-file .env.prod.local
# Copy it, fill in real values and keep the copy out of git (.env.*.local is git-ignored).
# Generate secrets with: openssl rand -hex 32

# Public domain; Caddy fetches a Let's Encrypt certificate for it. Use ":80" for plain HTTP.
SERVER_NAME=api.example.com

APP_SECRET=
JWT_PASSPHRASE=

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Regex of browser origins allowed to call the API (your frontend).
CORS_ALLOW_ORIGIN='^https://(www\.)?example\.com$'

# Host ports; change them when something else already listens on 80/443.
HTTP_PORT=80
HTTPS_PORT=443
