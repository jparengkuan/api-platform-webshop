{% extends 'base.html.twig' %}

{% block title %}Inloggen – Webshop{% endblock %}

{% block stylesheets %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root { color-scheme: light dark; --accent: #2563eb; --border: #d4d4d8; --error: #b91c1c; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; font: 16px/1.5 system-ui, sans-serif; background: Canvas; }
        main { width: min(22rem, 100% - 2rem); }
        h1 { font-size: 1.5rem; margin: 0 0 1.5rem; }
        label { display: block; font-weight: 600; margin: 1rem 0 .25rem; }
        input { box-sizing: border-box; width: 100%; padding: .6rem .75rem; border: 1px solid var(--border); border-radius: .375rem; font: inherit; }
        button { margin-top: 1.5rem; width: 100%; padding: .7rem; border: 0; border-radius: .375rem; background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
        .error { padding: .75rem; border: 1px solid var(--error); border-radius: .375rem; color: var(--error); }
    </style>
{% endblock %}

{% block body %}
    <main>
        <h1>Inloggen</h1>

        {% if error %}
            <p class="error" role="alert">
                {% if error.messageKey starts with 'Too many failed login attempts' %}
                    Te veel mislukte pogingen. Probeer het over een kwartier opnieuw.
                {% else %}
                    Onjuist e-mailadres of wachtwoord.
                {% endif %}
            </p>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <label for="email">E-mailadres</label>
            <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="username" required autofocus>

            <label for="password">Wachtwoord</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Inloggen</button>
        </form>
    </main>
{% endblock %}
