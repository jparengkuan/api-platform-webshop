# https://frankenphp.dev/docs/config
{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

# Default ":80": plain HTTP behind Varnish (compose.prod.yaml), with TLS terminated further out.
# Set SERVER_NAME to a domain only when running this image on its own, directly on the internet;
# Caddy then fetches a Let's Encrypt certificate automatically.
{$SERVER_NAME::80} {
	root /app/public
	encode zstd br gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	php_server {
		worker {
			file /app/public/index.php
			env FRANKENPHP_WORKER 1
		}
	}
}
